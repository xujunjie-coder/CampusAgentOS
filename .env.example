# ==============================================================================
# 配置样例（可入库，严禁写入任何真实密钥）
# 用法：复制为 .env 后按需修改 —— 本仓库 .env 亦入库，注意不要泄露真实密钥
# ==============================================================================

# ----- 大模型（默认引擎兜底；正式接入请在「模型引擎」后台配置）-----
# OpenAI 范式服务地址，需带 /v1 后缀
BASE_URL=http://127.0.0.1:11435/v1
# 访问密钥，按服务商要求填写；本地模型可留空
API_KEY=
# 模型标识
MODEL_ID=smart

# ----- 应用 -----
# 监听地址，默认 127.0.0.1（生产可设 0.0.0.0）
APP_HOST=127.0.0.1
# 监听端口，取值范围 1~65535，默认 10086
APP_PORT=10086
# 调试模式：1=开启调试页与自动重载；0=关闭（生产必须为 0）
DEBUG=1
# 会话与 cookie 签名密钥，必填，至少 32 位随机串；缺省或使用示例值会启动失败
# 生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
COOKIE_SECRET=please-change-me
# 是否开启 XSRF 防护：1=开启（默认，推荐）；0=关闭（仅本地排障）
XSRF_ENABLED=1
# 日志级别：DEBUG | INFO | WARNING | ERROR | CRITICAL，默认 INFO
LOG_LEVEL=INFO

# ----- 数据库 -----
# 驱动：sqlite | mysql，默认 sqlite；mysql 需先 pip install pymysql
DB_DRIVER=sqlite
# SQLite 数据文件路径（相对仓库根），仅在 DB_DRIVER=sqlite 时生效
DB_PATH=database/govagentos.db
# MySQL 连接参数（DB_DRIVER=mysql 时生效；服务端字符集为 utf8 的实例必须用 utf8mb4 连接）
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=govagentos
DB_CHARSET=utf8mb4

# ----- 会话与登录安全 -----
# 登录会话有效期（小时），默认 12
SESSION_TTL_HOURS=12
# 连续登录失败次数阈值，达到后锁定，默认 5
LOGIN_MAX_FAILS=5
# 锁定时长（分钟），0=不锁定，默认 10
LOGIN_LOCK_MINUTES=10

# ----- 人脸识别 -----
# 引擎：onnx（强制真实精度，缺模型则启动报错）| fallback（仅演示级，精度受限）| auto（有模型走 onnx，否则显式降级）
FACE_ENGINE=auto
# 比对阈值（ArcFace 余弦相似度），范围 0~1，默认 0.35
FACE_THRESHOLD=0.35
FACE_LIVENESS_THRESHOLD=0.75
# ONNX 模型目录（相对仓库根），内置 SCRFD + ArcFace 模型，不入库
FACE_MODEL_DIR=database/models/face

# ----- 流式与 WebSocket -----
# SSE 心跳间隔（秒），默认 15
SSE_HEARTBEAT_SECONDS=15
# WebSocket 心跳间隔（秒），默认 30
WS_HEARTBEAT_SECONDS=30

# ----- 跨域白名单 -----
# 逗号分隔的完整 Origin（含协议与端口）；留空表示只允许同源，不下发任何 CORS 头
CORS_ALLOW_ORIGINS=

# ----- 定时任务与消息通知（成员 E）-----
# 是否启用周期任务调度：1=启用（默认）；0=关闭（任务仅可手动触发）
# 装了 apscheduler 走 APScheduler（支持 cron），未装则降级为 tornado 事件循环调度（仅间隔任务自动排程）
SCHEDULER_ENABLED=1
# 邮件通知（SMTP）：全部留空即视为未配置，通知会显式降级而非静默失败
# 常见 SMTP 主机如 smtp.qq.com / smtp.163.com；465 端口走 SSL，587 端口可置 SMTP_SSL=0 用 STARTTLS
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
# 密码或授权码，仅允许写在本机 .env，严禁入库 / 文档 / 日志
SMTP_PASSWORD=
SMTP_SSL=1
# 发件人（留空则取 SMTP_USER）与收件人（多个用逗号分隔）
MAIL_FROM=
MAIL_TO=
# QQ 消息通知：优先机器人 webhook（填 QQ_WEBHOOK_URL 即走该通道）
QQ_WEBHOOK_URL=
# 无 webhook 时回退 QQ 邮箱 SMTP：填授权码邮箱与收件人（走 smtp.qq.com:465）
QQ_SMTP_USER=
QQ_SMTP_PASSWORD=
QQ_TO=

# ----- Jamendo 在线曲库（非商业用途）-----
# 在 https://devportal.jamendo.com/ 创建应用；填自己的 client_id，重启服务生效。
# 留空时 @音乐 明确提示并回退本地示例；不要将官方测试 ID 用于日常部署。
JAMENDO_CLIENT_ID=
